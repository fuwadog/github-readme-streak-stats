# Server-side GitHub PAT only; never expose this in a URL or client request.
TOKEN=

# Comma-separated GitHub usernames to allow; missing, empty, wildcard, or
# malformed configuration denies every username.
WHITELIST=

# Self-hosted file limiter: 100 requests per minute per client IP.
# Serverless deployments require an external limiter and fail closed unless
# this is explicitly enabled.
EXTERNAL_RATE_LIMITER=false

# Optional: disable caching (not recommended; may cause rate-limit issues).
DISABLE_CACHE=false

# Cache TTL in seconds for successful responses. CACHE_TTL overrides
# CACHE_TTL_DEFAULT when set. Errors are never cached.
CACHE_TTL_DEFAULT=18000
CACHE_TTL=

# Optional additional tokens for rate-limit failover. Add TOKEN3 through
# TOKEN100 as needed; add a replacement before revoking an old token.
# TOKEN2=
