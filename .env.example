# Local/self-hosted configuration template. Copy it to .env, keep that file
# untracked, and never expose a server-side GitHub PAT in a URL, client
# request, or command.
# For Vercel, add TOKEN as an encrypted Production Environment Variable
# instead of copying a secret into this file. Keep token failover values
# Production-scoped as well.
TOKEN=

# Comma-separated GitHub usernames to allow. For a local deployment, replace
# this with the exact users to serve; missing, empty, wildcard, or malformed
# configuration denies every username. Configure the user-managed Production
# value in Vercel, rather than storing it in this file.
WHITELIST=

# Local/self-hosted deployments use the file limiter: 100 requests per minute
# per client IP. Serverless deployments require an external limiter and fail
# closed unless this is explicitly enabled. On Vercel, configure the project
# WAF first, then enable the external-limiter flag in Production only. This
# flag is an assertion that the upstream limiter is active; it does not create
# one.
EXTERNAL_RATE_LIMITER=false

# Optional: disable caching (not recommended; may cause rate-limit issues).
DISABLE_CACHE=false

# Cache TTL in seconds for successful responses. CACHE_TTL overrides
# CACHE_TTL_DEFAULT when set. Errors are never cached. This local template
# uses five hours; if neither value is configured, the runtime falls back to
# one day.
CACHE_TTL_DEFAULT=18000
CACHE_TTL=

# Optional additional tokens for rate-limit failover. Add TOKEN3 through
# TOKEN100 as needed; add a replacement before revoking an old token.
# TOKEN2=
