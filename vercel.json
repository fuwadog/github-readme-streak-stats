{
	"routes": [
		{ "src": "/$", "dest": "/api/index.php?__route=api" },
		{
			"src": "/demo/preview\\.php(?:/.*)?$",
			"dest": "/api/index.php?__route=demo-preview"
		},
		{
			"src": "/demo/?$",
			"dest": "/api/index.php?__route=demo-index"
		},
		{
			"src": "/demo/(.+)$",
			"dest": "/api/index.php?__route=demo-static&__demo_path=$1"
		},
		{ "src": "/api/.*\\.php(?:/.*)?$", "status": 404 },
		{ "handle": "filesystem" }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "Access-Control-Allow-Origin", "value": "*" },
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "X-Frame-Options", "value": "DENY" },
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	],
	"functions": {
		"api/index.php": {
			"runtime": "vercel-php@0.7.4"
		}
	}
}
